cat("\n=== PART 11: Summary Table ===\n")

summary_table <- prop_long %>%
  group_by(Depot, Timepoint, CellType_Display) %>%
  summarise(Mean_Proportion = mean(Proportion, na.rm = TRUE) * 100, .groups = "drop") %>%
  mutate(Group = paste(Depot, Timepoint, sep = "_")) %>%
  dplyr::select(CellType_Display, Group, Mean_Proportion) %>%
  pivot_wider(names_from = Group, values_from = Mean_Proportion) %>%
  mutate(across(where(is.numeric), ~ sprintf("%.2f%%", .)))

col_order <- c("CellType_Display",
               "Abdominal_Baseline", "Abdominal_Developing obesity", "Abdominal_Prolonged Obesity",
               "Subcutaneous_Baseline", "Subcutaneous_Developing obesity", "Subcutaneous_Prolonged Obesity")
summary_table <- summary_table %>% dplyr::select(any_of(col_order))

write.csv(summary_table, "deconv_output/immune_summary_proportion_table.csv", row.names = FALSE)
cat("Saved: immune_summary_proportion_table.csv\n\n")

## =============================================================================
## PART 12: STATISTICAL TESTS (paired Wilcoxon, FDR corrected)
## =============================================================================

cat("=== PART 12: Statistical Tests ===\n")

run_pairwise_wilcox <- function(data, depot_name) {
  depot_data <- data %>% filter(Depot == depot_name)
  comparisons <- list(
    "Baseline vs Developing obesity" = c("Baseline", "Developing obesity"),
    "Baseline vs Prolonged Obesity"  = c("Baseline", "Prolonged Obesity"),
    "Developing obesity vs Prolonged Obesity" = c("Developing obesity", "Prolonged Obesity")
  )
  results <- lapply(unique(depot_data$CellType_Display), function(ct) {
    cell_data <- depot_data %>% filter(CellType_Display == ct)
    lapply(names(comparisons), function(comp_name) {
      tp <- comparisons[[comp_name]]
      g1 <- cell_data %>% filter(Timepoint == tp[1]) %>% pull(Proportion)
      g2 <- cell_data %>% filter(Timepoint == tp[2]) %>% pull(Proportion)
      p  <- tryCatch(
        wilcox.test(g1, g2, paired = TRUE, exact = FALSE)$p.value,
        error = function(e) NA_real_
      )
      data.frame(Depot = depot_name, CellType = ct, Comparison = comp_name,
                 P_value = p, stringsAsFactors = FALSE)
    })
  })
  do.call(rbind, unlist(results, recursive = FALSE))
}

stats_all <- rbind(
  run_pairwise_wilcox(prop_long, "Abdominal"),
  run_pairwise_wilcox(prop_long, "Subcutaneous")
)

stats_all$P_adjusted <- p.adjust(stats_all$P_value, method = "fdr")
stats_all$Significance <- dplyr::case_when(
  stats_all$P_adjusted < 0.001 ~ "***",
  stats_all$P_adjusted < 0.01  ~ "**",
  stats_all$P_adjusted < 0.05  ~ "*",
  stats_all$P_adjusted < 0.1   ~ ".",
  TRUE ~ "ns"
)

stats_out <- stats_all %>%
  mutate(across(c(P_value, P_adjusted), ~ sprintf("%.4f", .))) %>%
  rename(`P-value` = P_value, `Adj. P-value` = P_adjusted, `Sig.` = Significance)

write.csv(stats_out,
          "deconv_output/immune_statistical_tests_timepoint_comparisons.csv",
          row.names = FALSE)

# Wide format for easy reading
stats_wide <- stats_all %>%
  mutate(Result = paste0(sprintf("%.4f", P_adjusted), " (", Significance, ")")) %>%
  dplyr::select(Depot, CellType, Comparison, Result) %>%
  pivot_wider(names_from = Comparison, values_from = Result)

write.csv(stats_wide,
          "deconv_output/immune_statistical_tests_wide_format.csv",
          row.names = FALSE)
cat("Saved: statistical test tables\n")

sig_hits <- stats_all %>% filter(P_adjusted < 0.05) %>% arrange(P_adjusted)
if (nrow(sig_hits) > 0) {
  cat("\nSignificant findings (adj. p < 0.05):\n")
  print(sig_hits[, c("Depot","CellType","Comparison","P_adjusted","Significance")])
} else {
  cat("No significant differences after FDR correction.\n")
}
cat("\n")

